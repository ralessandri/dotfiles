#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

source "$HOME/.env" 2>/dev/null || {
  echo "Error: $HOME/.env not found" >&2
  exit 1
}

# Verify required variables are set before sourcing
: "${TBX_UTILS:?TBX_UTILS not set in ~/.env}"
: "${TBX_COMMON:?TBX_COMMON not set in ~/.env}"
: "${TBX_GUI_GUM:?TBX_GUI_GUM not set in ~/.env}"
: "${TBX_TASKS_DIR:?TBX_TASKS_DIR not set in ~/.env}"

source "$TBX_UTILS"
source "$TBX_COMMON"
source "$TBX_GUI_GUM"

print_section ":: Welcome to MyLinux Toolbox!"

if ! available gum; then
  print_section "Installing gum..."
  sudo dnf install -y gum
fi

show_menu "$TBX_TASKS_DIR"

