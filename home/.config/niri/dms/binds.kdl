binds {
    Mod+B hotkey-overlay-title="Default Web Browser: Open" { spawn "dms" "ipc" "call" "defaultApp" "browser"; }
    Mod+Ctrl+Escape { spawn "dms" "ipc" "powerprofile" "toogle"; }
    Mod+Ctrl+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Ctrl+P { spawn "dms" "ipc" "powerprofile" "toggle"; }
    Mod+E hotkey-overlay-title="Default File Manager: Open" { spawn "dms" "ipc" "call" "defaultApp" "fileManager"; }
    Mod+Shift+Return hotkey-overlay-title="Default Web Browser: Open" { spawn "dms" "ipc" "call" "defaultApp" "browser"; }
    Mod+V hotkey-overlay-title="Clipboard: Toggle" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+space hotkey-overlay-title="Spotlight Bar: Toggle" { spawn "dms" "ipc" "call" "spotlight-bar" "toggle"; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Shift+D { spawn "rofi-niri-workspaces.sh"; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Ctrl+Left { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+Right { move-column-right-or-to-monitor-right; }
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+S { spawn "niri-window-stack.sh" "toggle" "-m" "70%" "-f" "main-at-stack" "-w" "current"; }
    Mod+Shift+Left { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }
    Mod+Shift+S { spawn "niri-window-stack.sh" "promote"; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+Shift+Tab { spawn "sh" "-c" "niri msg action focus-column-right; niri msg action move-column-to-last; niri msg action focus-window-previous"; }
    Mod+T { spawn-sh "if niri msg --json focused-window | grep -q '\"is_floating\":true'; then niri msg action toggle-window-floating && niri msg action set-window-height '100%'; else niri msg action toggle-window-floating && niri msg action set-window-height '70%'; fi"; }
    Ctrl+H { spawn "alacritty" "--class" "alacritty-herdr" "-e" "herdr"; }
    Ctrl+Shift+H { spawn "rofi" "-show" "ssh" "-ssh-command" "alacritty -e herdr --remote {host}"; }
    Mod+Ctrl+Print { spawn "capture-text.sh"; }
    Mod+L { spawn "wezterm" "-e" "nvim"; }
    Mod+Return { spawn "wezterm"; }
    Mod+Shift+B { spawn "rofi-browser.sh"; }
    Mod+D hotkey-overlay-title="Toggle Overview" { toggle-overview; }
}
