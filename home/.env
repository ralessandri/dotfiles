# .env - Color scheme for bash script (pastel colors)

# Colors (256 colors)
PASTEL_BLUE='\033[38;5;153m'
PASTEL_YELLOW='\033[38;5;186m'
PASTEL_GREEN='\033[38;5;151m'
PASTEL_PINK='\033[38;5;218m'
NC='\033[0m' # No Color (reset)

# Library paths for tbx
TBX_LIB_DIR="$HOME/.dotfiles/home/.local/lib/bash"
TBX_TASKS_DIR="$TBX_LIB_DIR/tbx/tasks.d/"
TBX_UTILS="$TBX_LIB_DIR/core/utils.sh"
TBX_COMMON="$TBX_LIB_DIR/core/common.sh"
TBX_GUI_GUM="$TBX_LIB_DIR/gui/gui-gum.sh"