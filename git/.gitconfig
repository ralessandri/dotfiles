[init]
	defaultBranch = main
[diff]
	algorithm = histogram
[pull]
	rebase = true
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	cam = "commit -am"
	df = diff
	lg = log --oneline --graph --decorate --all
	sw = switch
	swc = switch -c
	swct = "!f() { git switch -c $1 --track origin/$1; }; f"
	stageall = add .
	stagepatch = add -p
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	history = log --oneline --graph --decorate --all
	last = log -1 --stat
[url "git@github.com:"]
	insteadOf = https://github.com/
[push]
	autoSetupRemote = true
	followTags = true
