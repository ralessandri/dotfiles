binds {
    Mod+Alt+space hotkey-overlay-title="Settings: Toggle" { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+Ctrl+Comma hotkey-overlay-title="Toggle Do Not Disturb" { spawn "dms" "ipc" "call" "notifications" "toggleDoNotDisturb"; }
    Mod+Ctrl+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Ctrl+P hotkey-overlay-title="Toggle Power Profile" { spawn "dms" "ipc" "powerprofile" "toggle"; }
    Mod+Ctrl+T hotkey-overlay-title="Toggle System Monitor" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Mod+Shift+Alt+Comma hotkey-overlay-title="Toggle Notification Center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard: Toggle" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+X hotkey-overlay-title="Toggle Power Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+space hotkey-overlay-title="Spotlight Bar: Toggle" { spawn "dms" "ipc" "call" "spotlight-bar" "toggle"; }
    Mod+Ctrl+Down hotkey-overlay-title="Move Window Down" { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up hotkey-overlay-title="Move Window Up" { move-window-up-or-to-workspace-up; }
    Mod+Down hotkey-overlay-title="Focus Window Below" { focus-window-or-workspace-down; }
    Mod+Shift+D hotkey-overlay-title="Open Workspace Switcher" { spawn "rofi-niri-workspaces.sh"; }
    Mod+Up hotkey-overlay-title="Focus Window Above" { focus-window-or-workspace-up; }
    Mod+B hotkey-overlay-title="Focus Firefox" { spawn-sh "niri msg action focus-window --id $(niri msg --json windows | jq -r '.[] | select(.app_id == \"org.mozilla.firefox\") | .id' | head -n1)"; }
    Mod+Ctrl+Left hotkey-overlay-title="Move Column Left" { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+Right hotkey-overlay-title="Move Column Right" { move-column-right-or-to-monitor-right; }
    Mod+Left hotkey-overlay-title="Focus Column Left" { focus-column-or-monitor-left; }
    Mod+Right hotkey-overlay-title="Focus Column Right" { focus-column-or-monitor-right; }
    Mod+S hotkey-overlay-title="Toggle Window Stack" { spawn "niri-window-stack.sh" "toggle" "-m" "70%" "-f" "main-at-stack" "-w" "current"; }
    Mod+Shift+Left hotkey-overlay-title="Move Window Into Left Column" { consume-or-expel-window-left; }
    Mod+Shift+Right hotkey-overlay-title="Move Window Into Right Column" { consume-or-expel-window-right; }
    Mod+Shift+S hotkey-overlay-title="Promote Stacked Window" { spawn "niri-window-stack.sh" "promote"; }
    Mod+Shift+T hotkey-overlay-title="Switch Tiling and Floating Focus" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+Tab hotkey-overlay-title="Cycle Column Focus" { spawn-sh "niri msg action focus-column-right; niri msg action move-column-to-last; niri msg action focus-window-previous"; }
    Mod+A hotkey-overlay-title="ChatGPT" { spawn "niri-cycle.sh" "chrome-chatgpt.com__-Default" "gtk-launch" "ChatGPT"; }
    Mod+Ctrl+Print hotkey-overlay-title="Extract Text From Screen" { spawn "capture-text.sh"; }
    Mod+E hotkey-overlay-title="Open Yazi" { spawn "alacritty" "-e" "yazi"; }
    Mod+H hotkey-overlay-title="Focus Herdr" { spawn "niri-cycle.sh" "alacritty-herdr" "alacritty" "--class" "alacritty-herdr" "-e" "herdr"; }
    Mod+L hotkey-overlay-title="Open Neovim" { spawn "alacritty" "-e" "nvim"; }
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "alacritty"; }
    Mod+Shift+B hotkey-overlay-title="Open Browser Selector" { spawn "rofi-browser.sh"; }
    Mod+Shift+H hotkey-overlay-title="Open SSH Connections" { spawn "rofi" "-show" "ssh" "-ssh-command" "alacritty -e herdr --remote {host}"; }
    Mod+Shift+Return hotkey-overlay-title="Focus Firefox" { spawn "niri-cycle.sh" "org.mozilla.firefox" "firefox"; }
    Mod+T hotkey-overlay-title="Toggle Floating" { spawn "niri-toggle-floating.sh"; }
    Mod+Y hotkey-overlay-title="Open YouTube" { spawn "gtk-launch" "Youtube"; }
    Mod+D hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    Mod+F1 hotkey-overlay-title="Show Keybindings" { show-hotkey-overlay; }
}
