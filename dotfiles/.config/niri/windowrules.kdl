window-rule {
  match is-active=false
  opacity 0.8
}

window-rule {
  match is-focused=true
  opacity 0.95
}

window-rule {
  match app-id="^alacritty-herdr$"
  background-effect {
    blur true
  }
}

window-rule {
  // match app-id="calibre-ebook-edit"
  // open-floating true
}

// Keep the interactive DNF package installer above tiled windows.
window-rule {
  match app-id="^dnf-package-install$"
  open-floating true
  default-column-width { proportion 0.3; }
  default-window-height { proportion 0.6; }
}

// Keep the interactive DNF package remover above tiled windows.
window-rule {
  match app-id="^dnf-package-remove$"
  open-floating true
  default-column-width { proportion 0.3; }
  default-window-height { proportion 0.6; }
}

// Keep the interactive Wi-Fi manager above tiled windows.
window-rule {
  match app-id="^wifi-manager$"
  open-floating true
  default-column-width { fixed 650; }
  default-window-height { fixed 400; }
}
