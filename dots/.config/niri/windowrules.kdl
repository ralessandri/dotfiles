window-rule {
  match is-active=false
  opacity 0.7
}

window-rule {
  match is-focused=true
  opacity 0.8
}

// Float terminal windows launched for dotfiles commands.
window-rule {
  match app-id=r#"^dot\.[^.]+\.[^.]+$"#
  open-floating true
  default-column-width { fixed 875; }
  default-window-height { fixed 600; }
}

window-rule {
  match app-id=r#"^dot\.yazi\.floating$"#
  open-floating true
}

window-rule {
  background-effect {
    blur true
  }
}

// Keep interactive package and Wi-Fi managers above tiled windows.
window-rule {
  match app-id=r#"^(dot\.dnf\.(install|remove)|dot\.wifi\.manager)$"#
  open-floating true
  default-column-width { fixed 800; }
  default-window-height { fixed 600; }
}

window-rule {
  match app-id="com.gabm.satty"
  open-floating true
}

window-rule {
  match app-id="org.gnome.NautilusPreviewer"
  open-floating true
}

window-rule {
  match app-id="nm-connection-editor"
  open-floating true
}
