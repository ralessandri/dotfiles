  // Update
  "update.system": {"icon":"system_update","label":"System","aliases":["system-updates","packages"],"action":"foot --app-id=dotfiles.update launch-floating-terminal-with-presentation.sh update.sh"},
  "update.codex": {"icon":"code","label":"Codex","aliases":["codex update","openai codex"],"when":"command -v codex >/dev/null 2>&1","action":"foot --app-id=dotfiles.codex-update launch-floating-terminal-with-presentation.sh codex update"},
  "update.bw": {"icon":"key","label":"Bitwarden CLI","aliases":["bw","bw update","bitwarden"],"when":"command -v bw >/dev/null 2>&1","action":"foot --app-id=dotfiles.bw-update launch-floating-terminal-with-presentation.sh bw-update.sh"},
